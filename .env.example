# Copy to .env and set a random URL-safe value (hex is suitable).
TALENT_DB_PASSWORD=
TALENT_API_PORT=8001
TALENT_WEB_PORT=3003

TALENT_PUBLIC_ORIGIN=http://localhost:3003
TALENT_CSRF_SECRET=
# Initial reviewer credentials are only read by make seed-access.
TALENT_REVIEWER_LOGIN=
TALENT_REVIEWER_PASSWORD=

# Optional server-only gateway. See docs/integrations/local-freellmapi.md.
# compose.llm.yaml joins the existing FreeLLMAPI network for the worker.
TALENT_LLM_BASE_URL=http://freellmapi:3001/v1
TALENT_LLM_API_KEY=
TALENT_LLM_MODEL=gpt-oss-120b
TALENT_LLM_OCR_MODEL=gemini-3.5-flash-lite
TALENT_LLM_EMBEDDING_MODEL=gemini-embedding-001
TALENT_LLM_EMBEDDING_DIMENSIONS=3072
TALENT_LLM_TIMEOUT_SECONDS=30
