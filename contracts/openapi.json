            "title": "Assessment Mode"
          },
          "condition_rule": {
            "anyOf": [
              {
                "discriminator": {
                  "mapping": {
                    "available_by_date": "#/components/schemas/DateCondition",
                    "available_slots": "#/components/schemas/SlotsCondition"
                  },
                  "propertyName": "kind"
                },
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/DateCondition"
                  },
                  {
                    "$ref": "#/components/schemas/SlotsCondition"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Condition Rule"
          },
          "evaluation_mode": {
            "enum": [
              "qualitative",
              "deterministic"
            ],
            "title": "Evaluation Mode",
            "type": "string"
          },
          "expectation": {
            "maxLength": 2000,
            "title": "Expectation",
            "type": "string"
          },
          "family": {
            "maxLength": 100,
            "title": "Family",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "importance": {
            "enum": [
              "required",
              "desired"
            ],
            "title": "Importance",
            "type": "string"
          },
          "source_question_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 50,
            "title": "Source Question Ids",
            "type": "array"
          }
        },
        "required": [
          "id",
          "family",
          "expectation",
          "importance",
          "evaluation_mode",
          "source_question_ids"
        ],
        "title": "Requirement",
        "type": "object"
      },
      "Reviewer": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
